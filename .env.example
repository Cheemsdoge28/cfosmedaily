# ─────────────────────────────────────────────────────────────────────────────
# RISEBIT CFO Dashboard — environment configuration
# Copy to `.env.local` (development) or set in the Vercel project (production).
# NEVER commit a filled-in copy of this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon / PostgreSQL) ─────────────────────────────────────────────
# DATABASE_URL  : pooled connection (app runtime, serverless-safe).
#                 On Neon this is the host containing "-pooler".
# DIRECT_URL    : direct, unpooled connection (migrations only).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/risebit?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/risebit?sslmode=require"

# ── Application secrets ──────────────────────────────────────────────────────
# 32-byte base64 key used for AES-256-GCM encryption of stored Zoho tokens.
# Generate with: npm run keygen
APP_ENCRYPTION_KEY=""

# Shared secret required by the scheduled sync endpoint (/api/cron/sync).
# Generate with: npm run keygen
CRON_SECRET=""

# Canonical origin. Used for secure-cookie decisions, the Zoho OAuth redirect
# URI and same-origin checks on mutating requests.
APP_URL="http://localhost:3000"

# ── Zoho Books OAuth (optional until you connect a client) ───────────────────
# Create a "Server-based Application" at https://api-console.zoho.com
# Authorized redirect URI must be: {APP_URL}/api/zoho/callback
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
# Data centre of the Zoho account: com | in | eu | au | jp | ca | sa
ZOHO_REGION="in"

# ── Seeding (optional) ───────────────────────────────────────────────────────
# Passwords for the demo accounts created by `npm run db:seed`.
# If unset, the seed generates random passwords and prints them once.
SEED_ADMIN_EMAIL="admin@risebitcfo.com"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""
