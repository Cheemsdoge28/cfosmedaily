# ─────────────────────────────────────────────────────────────────────────────
# CFOSME Pulse Pro — environment configuration
# Copy to `.env.local` (development) or set in the Vercel project (production).
# NEVER commit a filled-in copy of this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon / PostgreSQL) ─────────────────────────────────────────────
# DATABASE_URL  : pooled connection (app runtime, serverless-safe).
#                 On Neon this is the host containing "-pooler".
# DIRECT_URL    : direct, unpooled connection (migrations and seeding only).
#                 Neon's pooler cannot run the DDL `prisma migrate` issues.
#
# Neon's own Vercel integration writes the unpooled URL as DATABASE_URL_UNPOOLED
# (and POSTGRES_URL_NON_POOLING). Either name works — prisma.config.ts looks for
# all three — so an .env pasted straight out of Neon needs no editing.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Application ──────────────────────────────────────────────────────────────
# Canonical origin. Decides the `Secure` cookie flag and the same-origin checks
# on mutating requests.
APP_URL="http://localhost:3000"

# There is deliberately no encryption key and no cron secret. The portal this was
# forked from stored Zoho OAuth tokens and needed both; nothing here holds a
# credential it has to read back, so they are gone rather than left unused.

# ── Seeding (optional) ───────────────────────────────────────────────────────
# Passwords for the two accounts `npm run db:seed` creates. If unset, the seed
# generates random ones and prints them once.
SEED_ADMIN_EMAIL="admin@cfosme.test"
SEED_ADMIN_PASSWORD=""
SEED_CLIENT_PASSWORD=""
