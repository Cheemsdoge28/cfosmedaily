// CFOSME Pulse Pro — data model
//
// Design notes
// ────────────
// 1. Multi-tenant. Every business row carries `clientId`, and every read is
//    filtered to the clients the caller has been granted — see ClientAccess and
//    src/lib/tasks/scope.ts. CFOSME staff are PLATFORM_ADMIN and read across
//    every client, which is what the dashboard's cross-client comparisons need;
//    everyone else sees exactly the clients on their grant list, at the level
//    each grant gives them.
// 2. Credentials live here, hashed with bcrypt — never in a config file.
// 3. Sessions are server-side and revocable: the cookie holds an opaque token,
//    the database stores only its SHA-256 hash.
// 4. A task's *state* is two stored fields — `status` and `progress` — and
//    nothing else. Completion rates, overdue counts and the client and owner
//    rollups are derived at query time, so a figure on the dashboard can never
//    disagree with the register it came from.
// 5. Due dates are stored twice on purpose. `dueDate` is the resolved calendar
//    date the dashboard counts as overdue; `dueText` keeps what the workbook
//    actually said when the cell was not a date ("20th Sept "), so a reader can
//    always see the source wording and an unresolvable cell is visibly
//    unresolved rather than silently dropped.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URLs live in prisma.config.ts (Prisma 7 moved them out of the
// schema). See DATABASE_URL / DIRECT_URL in .env.example.
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy and access
// ─────────────────────────────────────────────────────────────────────────────

/// A client company whose compliance and reporting calendar CFOSME runs.
model Client {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  legalName String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     Task[]
  auditLogs AuditLog[]
  access    ClientAccess[]

  @@index([isActive])
}

/// What an account is, as distinct from what it can see.
///
/// Only two, because only two things are actually being decided here: whether
/// somebody administers the portal, or whether they are simply a person with
/// access to some clients. Which clients, and whether they may edit them, is not
/// a property of the account — it is a list of grants (see ClientAccess), which
/// is the whole point of the change away from CLIENT_ADMIN and VIEWER.
enum Role {
  /// CFOSME staff who run the portal: every client, plus clients, logins and imports.
  PLATFORM_ADMIN
  /// Anyone else. Sees exactly the clients granted to them, at the level granted.
  MEMBER
}

/// How much a grant allows.
enum AccessLevel {
  /// Read the register and the dashboard.
  VIEW
  /// Also move tasks — set a status, drag progress.
  EDIT
}

/// A portal login.
///
/// Deliberately carries no `clientId`. It used to, which made "one person, one
/// client" a fact of the schema: a CFOSME reviewer covering four clients needed
/// four accounts, and a client's finance lead who should see one entity read-only
/// and another read-write could not be expressed at all. Visibility now lives
/// entirely in `access`, so there is one place to read it and one place to change
/// it.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  role         Role    @default(MEMBER)
  isActive     Boolean @default(true)

  /// Brute-force protection.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  /// Forces a password change on next sign-in (used after an admin reset).
  mustChangePassword Boolean @default(false)

  /// When the account was removed, and by whom. Removal is a mark, never a
  /// delete: the row stays, and so does everything that points at it — the
  /// audit trail, the task history, the imports it ran, the grants it held.
  ///
  /// Hard-deleting a user would take the answer to "who moved this task to
  /// Done in September" with it, and that is the one question the register
  /// exists to answer. So a removed account is simply invisible: it cannot
  /// sign in, it holds no live sessions, and it is filtered out of every
  /// listing except the administration screen that can bring it back.
  deletedAt   DateTime?
  deletedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions     Session[]
  auditLogs    AuditLog[]
  taskEvents   TaskEvent[]
  taskImports  TaskImport[]
  tasksTouched Task[]         @relation("TaskLastUpdatedBy")
  access       ClientAccess[]
  grantsMade   ClientAccess[] @relation("ClientAccessGrantedBy")

  deletedBy      User?  @relation("UserRemovedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  accountsRemoved User[] @relation("UserRemovedBy")

  @@index([email])
  /// Every listing filters on this, so it earns an index.
  @@index([deletedAt])
}

/// One person's access to one client.
///
/// The join table that replaces `User.clientId`. Every non-administrator read is
/// filtered to the clients listed here for that user, and `level` decides whether
/// they may move a task — per client, so the same person can be read-write on one
/// and read-only on another.
///
/// `grantedById` and `createdAt` are kept because access is the thing people ask
/// about after the fact: who gave this person sight of this client, and when.
model ClientAccess {
  id       String      @id @default(cuid())
  userId   String
  clientId String
  level    AccessLevel @default(VIEW)

  grantedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  grantedBy User?  @relation("ClientAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  /// One grant per person per client — the level is a field, not a second row.
  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
}

/// Server-side session. The cookie carries a random token; only its SHA-256
/// hash is persisted, so a database leak cannot be replayed as a login.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  /// Absolute expiry. Idle expiry is enforced via `lastSeenAt`.
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  ipAddress  String?
  userAgent  String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Append-only security and audit trail.
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  clientId  String?
  detail    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([clientId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// The task register
// ─────────────────────────────────────────────────────────────────────────────

/// Where a task stands. The five states the register has always used.
enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  AT_RISK
  BLOCKED
  DONE
}

/// How often a task comes round.
///
/// An enum rather than free text: the dashboard groups by it, and a workbook
/// column will always drift to "Monthly" and "Monthly " as separate values. The
/// importer maps case- and space-insensitively and reports anything it cannot
/// place, rather than inventing a bucket for it.
enum Frequency {
  DAILY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  AD_HOC
}

/// What moved a task — someone editing the register, or a workbook import.
enum ChangeSource {
  MANUAL
  IMPORT
}

/// One recurring obligation for one client.
model Task {
  id       String @id @default(cuid())
  clientId String
  /// The workbook's own "Task ID" (TS0001). Globally unique there, so it is
  /// the natural key an import upserts on — and it lets a task be moved
  /// between clients by editing one cell, rather than being duplicated.
  reference String @unique

  process     String
  activity    String
  description String @default("")
  /// The person accountable, as the workbook names them. Deliberately a string
  /// and not a relation: owners are recorded by CFOSME in the workbook and are
  /// not portal logins, so a foreign key would force an account for each.
  owner     String
  frequency Frequency

  /// The cadence in the practice's own words — "8th", "3rd working day".
  dueRule String    @default("")
  /// The resolved due date, when one could be determined.
  dueDate DateTime?
  /// The workbook's raw wording, kept when the cell was not a real date.
  dueText String?

  status TaskStatus @default(NOT_STARTED)
  /// 0-100. A CHECK constraint in the migration enforces the range in the
  /// database as well, so a bad write cannot land even from outside the app.
  progress Int    @default(0)
  notes    String @default("")

  /// Who last moved it, and when it last moved — the workbook's two trailing
  /// columns, which the export writes back.
  updatedById     String?
  statusChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  updatedBy User?       @relation("TaskLastUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  events    TaskEvent[]

  @@index([clientId])
  @@index([status])
  @@index([owner])
  @@index([dueDate])
  @@index([clientId, status])
}

/// Append-only history of every status or progress move.
///
/// The workbook could only ever hold the *latest* editor and timestamp, so who
/// moved a task off "Blocked" last month was unrecoverable. This keeps the
/// whole trail, which is what makes the register answerable after the fact.
model TaskEvent {
  id     String  @id @default(cuid())
  taskId String
  userId String?

  fromStatus   TaskStatus?
  toStatus     TaskStatus?
  fromProgress Int?
  toProgress   Int?
  source       ChangeSource @default(MANUAL)
  note         String?

  createdAt DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([createdAt])
}

enum ImportStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/// One workbook upload, and what it did.
///
/// The spreadsheet is still where the practice keeps the register, so every
/// import is recorded with its counts: an operator can see that last Tuesday's
/// upload created four tasks and skipped two, without reading the audit log.
model TaskImport {
  id       String  @id @default(cuid())
  userId   String?
  fileName String

  rowsRead  Int @default(0)
  created   Int @default(0)
  updated   Int @default(0)
  unchanged Int @default(0)
  skipped   Int @default(0)

  /// Per-row problems, in the operator's words. Empty on a clean import.
  errors     String[]
  status     ImportStatus @default(RUNNING)
  startedAt  DateTime     @default(now())
  finishedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([startedAt])
}
